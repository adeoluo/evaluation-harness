flowchart LR
    classDef edge     fill:#F59E0B,stroke:#1E293B,color:#1E293B,stroke-width:1px;
    classDef core     fill:#6366F1,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef data     fill:#10B981,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef control  fill:#0EA5E9,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef obs      fill:#CBD5E1,stroke:#1E293B,color:#1E293B,stroke-width:1px;

    subgraph Interfaces["Interfaces"]
        direction TB
        Users([Users and clients]):::edge
        CLI["CLI<br/>run, compare, serve"]:::edge
        Router["HTTP service<br/>/evaluate /compare"]:::core
        Validate["Validation<br/>names, confidence, seed"]:::control
        Users --> CLI ~~~ Router --> Validate
    end

    subgraph State["Data and state"]
        direction TB
        Catalog[("Tasks and models<br/>4 tasks, 7 models")]:::data
        Registries["Registries<br/>build_model, load_task"]:::core
        Records[("Run records<br/>JSON save and load")]:::data
        Catalog --> Registries ~~~ Records
    end

    subgraph Core["Runner and graders"]
        direction TB
        Runner["Runner<br/>threads, retries"]:::core
        Cache["CachingModel<br/>memoized predictions"]:::core
        Providers([OpenAI, Anthropic<br/>optional adapters]):::edge
        Graders["16 graders<br/>exact, F1, ROUGE-L"]:::core
        Runner -->|predict| Cache -->|cache miss| Providers
        Providers ~~~ Graders
    end

    subgraph Obs["Statistics and reporting"]
        direction TB
        Bootstrap["Bootstrap CI<br/>mean and interval"]:::obs
        Significance["Significance tests<br/>bootstrap, McNemar"]:::obs
        Reports["Reports<br/>table, MD, HTML, JSON"]:::obs
        Checks["Regression and<br/>contamination checks"]:::obs
        Metrics["Metrics<br/>Prometheus text"]:::obs
        Bootstrap --> Reports ~~~ Significance ~~~ Checks ~~~ Metrics
    end

    Interfaces -->|names| State
    State -->|model, task| Core
    Core -->|scores| Obs
    State -.->|run records| Obs
