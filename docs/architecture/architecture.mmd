---
title: System Architecture - Evaluation Harness
config:
  theme: base
  themeVariables:
    fontFamily: "Inter, system-ui, sans-serif"
    primaryColor: "#F8FAFC"
    primaryBorderColor: "#1E293B"
    primaryTextColor: "#1E293B"
    lineColor: "#64748B"
    clusterBkg: "#EEF2FF"
    clusterBorder: "#94A3B8"
---
flowchart TB
    classDef edge     fill:#F59E0B,stroke:#1E293B,color:#1E293B,stroke-width:1px;
    classDef core     fill:#6366F1,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef data     fill:#10B981,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef control  fill:#0EA5E9,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef obs      fill:#CBD5E1,stroke:#1E293B,color:#1E293B,stroke-width:1px;

    Client([Client]):::edge

    subgraph Edge["Service layer (stdlib HTTP, stateless)"]
        direction TB
        Router["Router<br/>/health | /evaluate | /compare"]:::core
        Validate["Validation<br/>known model/task, bounds"]:::control
    end

    subgraph Run["Evaluation"]
        direction TB
        Runner["Runner<br/>model x task, seeded"]:::core
        Grader["Grader<br/>score each example"]:::core
    end

    subgraph Stats["Statistics"]
        direction TB
        Bootstrap["Bootstrap aggregate<br/>mean + confidence interval"]:::core
        Significance["Significance test<br/>paired bootstrap / McNemar"]:::core
    end

    Tasks[(Built-in tasks)]:::data
    Models[(Built-in models)]:::data
    Report["Error-barred metrics<br/>+ significance verdict"]:::obs

    Client -->|JSON request| Router --> Validate
    Tasks -.-> Runner
    Models -.-> Runner
    Validate -->|model + tasks| Runner
    Runner --> Grader
    Grader -->|scores| Bootstrap
    Grader -->|paired scores| Significance
    Bootstrap --> Report
    Significance --> Report
    Report --> Router -->|JSON response| Client
