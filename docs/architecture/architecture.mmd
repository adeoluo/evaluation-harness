flowchart TD
    classDef edge     fill:#F59E0B,stroke:#1E293B,color:#1E293B,stroke-width:1px;
    classDef core     fill:#6366F1,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef data     fill:#10B981,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef control  fill:#0EA5E9,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef obs      fill:#CBD5E1,stroke:#1E293B,color:#1E293B,stroke-width:1px;

    User([CLI user]):::edge
    Client([HTTP client]):::edge
    Providers([OpenAI and Anthropic<br/>optional adapters]):::edge

    subgraph Interfaces["Interfaces (CLI and stdlib HTTP)"]
        direction TB
        CLI["cli.py<br/>list | run | compare | serve"]:::edge
        Router["service.py router<br/>/health /ready /evaluate /compare /metrics"]:::core
        Validate["Request validation<br/>known names, confidence, seed"]:::control
    end

    subgraph Core["Core logic (runner and graders)"]
        direction TB
        Registries["Registries<br/>build_model, load_task"]:::core
        Runner["Runner<br/>thread pool, retries with backoff"]:::core
        Cache["CachingModel<br/>memoized predictions"]:::core
        Graders["16 graders<br/>exact, F1, ROUGE-L, rubric, composite"]:::core
    end

    subgraph State["Data and state"]
        direction TB
        Tasks[("4 bundled tasks<br/>arithmetic, sentiment, entailment, QA")]:::data
        Models[("Offline models<br/>baselines and heuristics")]:::data
        Records[("RunRecord JSON<br/>lossless save and load")]:::data
    end

    subgraph Obs["Statistics, reporting, and observability"]
        direction TB
        Bootstrap["Bootstrap aggregate<br/>mean and confidence interval"]:::obs
        Significance["Significance<br/>paired bootstrap, McNemar"]:::obs
        Checks["Regression and contamination<br/>deltas, flips, n-gram overlap"]:::obs
        Reports["Reports<br/>table, Markdown, HTML, JSON"]:::obs
        Metrics["ServiceMetrics<br/>Prometheus text"]:::obs
    end

    User -->|arguments| CLI
    Client -->|JSON request| Router
    Router -->|POST /evaluate, /compare| Validate
    CLI -->|model and task names| Registries
    Validate -->|model and task names| Registries
    Tasks -.-> Registries
    Models -.-> Registries
    Registries -->|model and task| Runner
    Runner -->|predict| Cache
    Cache -->|cache miss| Providers
    Runner -->|predictions| Graders
    Graders -->|per-example scores| Bootstrap
    Graders -->|paired scores| Significance
    Bootstrap --> Reports
    Significance --> Reports
    Runner -->|TaskResult| Records
    Records -.->|baseline vs candidate| Checks
    Tasks -.->|n-gram scan| Checks
    Router -.->|route latency and errors| Metrics
