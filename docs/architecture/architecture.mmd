---
title: System Architecture - Evaluation Harness
config:
  theme: base
  themeVariables:
    fontFamily: "Inter, system-ui, sans-serif"
    primaryColor: "#F8FAFC"
    primaryBorderColor: "#1E293B"
    primaryTextColor: "#1E293B"
    lineColor: "#64748B"
    clusterBkg: "#E2E8F0"
    clusterBorder: "#94A3B8"
---
flowchart LR
    classDef core     fill:#6366F1,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef data     fill:#10B981,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef external fill:#F59E0B,stroke:#1E293B,color:#1E293B,stroke-width:1px;

    User([User / CLI]):::external

    subgraph Registries["Registries"]
        Tasks[(Task registry)]:::data
        Models[(Model registry)]:::data
    end

    subgraph Engine["Evaluation Engine"]
        Runner[Runner]:::core
        Grader[Grader]:::core
        Stats[Bootstrap statistics]:::core
    end

    Contam[Contamination scan]:::core

    subgraph Output["Reporting"]
        Table[Text table]:::core
        Json[JSON report]:::core
    end

    Provider{{LLM provider}}:::external

    User -->|run| Runner
    Models -->|build| Runner
    Tasks -->|load| Runner
    Runner -->|generate| Provider
    Runner -->|score| Grader
    Runner -->|scores| Stats
    Stats --> Table
    Stats --> Json
    Tasks -.->|examples| Contam
    Table -->|results| User
    Json -->|results| User
